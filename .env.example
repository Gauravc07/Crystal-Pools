# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# ── Public (bundled into the browser; Vite exposes only VITE_* vars) ──
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_WEB3FORMS_KEY="..."
# Website address — used by the admin panel for "View page" links and to show the site's built-in images
VITE_PUBLIC_SITE_URL="https://www.crystalpools.in"

# ── Server / scripts only. NEVER prefix these with VITE_ ──
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Production server: canonical URL used in SEO tags and the sitemap
PUBLIC_SITE_URL="https://www.crystalpools.in"
# Session pooler connection string (Project Settings → Database → Connect)
SUPABASE_DB_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
