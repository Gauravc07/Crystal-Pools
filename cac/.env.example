# CAC runs entirely on Supabase. Copy to cac/.env (git-ignored) and fill in.
# Check everything with: npm --prefix cac run doctor

# ── Staff app (bundled into the browser; publishable values only) ──
VITE_CAC_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_CAC_SUPABASE_PUBLISHABLE_KEY=

# ── Setup script only (npm run setup). Never prefix these with VITE_ ──
# Session pooler connection string (Supabase → Connect)
CAC_SUPABASE_DB_URL=
CAC_ADMIN_EMAIL=
CAC_ADMIN_NAME=CAC admin
# At least 12 characters. Not needed if CAC_ADMIN_EMAIL is already a Supabase Auth user.
CAC_ADMIN_PASSWORD=
# true adds synthetic demo records to an empty workspace
CAC_SEED_DEMO=false

# ── Worker (local: npm run worker / dev; deployed: copied by npm run deploy:worker) ──
# Secret key (Project Settings → API keys). Only for the local worker.
CAC_SUPABASE_SECRET_KEY=

# Assistant provider: demo (rules, free) | anthropic (Claude) | huggingface | openai
CAC_AI_MODE=demo

# Claude (Anthropic): key from platform.claude.com, API keys
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the low-cost default (about $0.01 per report); claude-opus-5-5 reads more carefully
CAC_ANTHROPIC_MODEL=claude-haiku-5-5

# Hugging Face Inference Providers — fine-grained token with "Make calls to Inference Providers":
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# Free accounts have no monthly credits; buy credits or use PRO ($2/month included).
HF_TOKEN=
CAC_HF_MODEL=openai/gpt-oss-120b:cheapest
CAC_HF_FALLBACK_MODELS=Qwen/Qwen3-32B,meta-llama/Llama-3.3-70B-Instruct
# Survey photos; leave empty to skip image analysis
CAC_HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Optional: bill a Hugging Face Team/Enterprise organisation
CAC_HF_BILL_TO=

# OpenAI (only when CAC_AI_MODE=openai; also enables web search for prospect research)
OPENAI_API_KEY=
CAC_OPENAI_MODEL=gpt-4.1-mini

# Project lead reports from Gmail (read-only). Google Cloud → APIs & Services: enable the
# Gmail API, then Credentials → OAuth client ID, type "Desktop app". Set the two values
# below, then run `npm --prefix cac run gmail:auth` to fill GMAIL_REFRESH_TOKEN.
# Leave empty to use manual uploads only (Project leads → Upload report).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Deployed worker only: origin of the hosted staff app (CORS) and the scheduler secret
CAC_APP_ORIGIN=
CAC_WORKER_SECRET=
