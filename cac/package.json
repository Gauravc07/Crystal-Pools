{
  "name": "crystal-pools-cac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "deploy:worker": "node --env-file-if-exists=.env scripts/deploy-worker.mjs",
    "gmail:auth": "node --env-file-if-exists=.env scripts/gmail-auth.mjs",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "0.546.0",
    "pg": "^8.23.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0"
  }
}
