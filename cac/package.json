{
  "name": "crystal-pools-cac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "setup": "node --env-file=.env scripts/setup.mjs",
    "doctor": "node --env-file=.env scripts/doctor.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "0.546.0",
    "pg": "^8.23.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0"
  }
}
